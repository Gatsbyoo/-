   "code": [
    "class Solution {",
    "public:",
    "    vector<int> twoSum(vector<int>& nums, int target) {",
    "        unordered_map<int, int> seen;",
    "        for (int i = 0; i < nums.size(); i++) {",
    "            int x = nums[i];",
    "            if (seen.count(target - x))",
    "                return {seen[target - x], i};",
    "            seen[x] = i;",
    "        }",
    "        return {};",
    "    }",
    "};"
   ],
   "notes": {
    "3": "值 → 下标，存「已经见过」的元素",
    "4": "先查后存，一趟遍历就够",
    "5": "搭档 = 目标和 − 当前值",
    "6": "先查：搭档出现过就直接返回两个下标",
    "7": "后存：把自己登记进表",
    "9": "题目保证有解，兜底返回空"
   },
